#!/usr/bin/env bash
#
# Mock systemctl for bats tests. Bats prepends _fixtures/ to PATH so this
# wins over the real binary.
#
# Reads SYSTEMCTL_BEHAVIOR env var to decide what to do:
#   ok          (default): every invocation exits 0
#   fail-start          : exit 1 when first arg is "start"
#   fail-stop           : exit 1 when first arg is "stop"
#   fail-restart        : exit 1 when first arg is "restart"
#
# Appends "<argv>\n" to SYSTEMCTL_LOG (if set) so tests can assert the
# script invoked systemctl in the expected order with the expected args.

if [[ -n "${SYSTEMCTL_LOG:-}" ]]; then
  printf '%s\n' "$*" >> "$SYSTEMCTL_LOG"
fi

action="${1:-}"

case "${SYSTEMCTL_BEHAVIOR:-ok}" in
  ok) exit 0 ;;
  fail-start)
    [[ "$action" == "start" ]] && exit 1
    exit 0
    ;;
  fail-stop)
    [[ "$action" == "stop" ]] && exit 1
    exit 0
    ;;
  fail-restart)
    [[ "$action" == "restart" ]] && exit 1
    exit 0
    ;;
  *)
    echo "mock systemctl: unknown SYSTEMCTL_BEHAVIOR='$SYSTEMCTL_BEHAVIOR'" >&2
    exit 2
    ;;
esac
