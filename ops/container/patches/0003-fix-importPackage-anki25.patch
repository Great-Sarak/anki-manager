+    def test_importPackageWithLog(self, session_with_profile_loaded):
+        # Anki 23.10+ only; skip if running against an older Anki where the
+        # modern collection API isn't available.
+        if not hasattr(aqt.mw.col, 'import_anki_package'):
+            pytest.skip("requires Anki 23.10+ (col.import_anki_package)")
+
+        filename = session_with_profile_loaded.base + "/export.apkg"
+
+        with current_decks_and_models_etc_preserved():
+            set_up_test_deck_and_test_model_and_two_notes()
+            ac.exportPackage(deck="test_deck", path=filename)
+
+        with current_decks_and_models_etc_preserved():
+            assert "test_deck" not in ac.deckNames()
+            result = ac.importPackageWithLog(path=filename)
+            assert "test_deck" in ac.deckNames()
+            # Two notes were exported; the log should reflect that.
+            assert result["found_notes"] == 2
+            assert result["new"] == 2
+            assert result["updated"] == 0
+            assert result["deck_count_after"] >= 1
+
