     @util.api()
+    def importPackageWithLog(self, path, mergeNotetypes=False, updateNotes='IF_NEWER',
+                              updateNotetypes='IF_NEWER', withScheduling=True,
+                              withDeckConfigs=True):
+        """Like importPackage but returns a rich import-log summary.
+
+        Requires Anki 23.10+ (uses col.import_anki_package). Returns a dict
+        with note counts and post-import deck count instead of a boolean,
+        so clients can verify the import actually changed the collection.
+
+        updateNotes / updateNotetypes accept: 'IF_NEWER', 'ALWAYS', 'NEVER'.
+        """
+        collection = self.collection()
+        if collection is None:
+            raise Exception('no collection loaded')
+        if not hasattr(collection, 'import_anki_package'):
+            raise Exception(
+                'importPackageWithLog requires Anki 23.10+; '
+                'use importPackage on older Anki versions'
+            )
+        from anki.collection import (
+            ImportAnkiPackageRequest,
+            ImportAnkiPackageOptions,
+        )
+        update_condition = {'IF_NEWER': 0, 'ALWAYS': 1, 'NEVER': 2}
+        if updateNotes not in update_condition:
+            raise Exception(
+                f"updateNotes must be one of {sorted(update_condition.keys())}; "
+                f"got {updateNotes!r}"
+            )
+        if updateNotetypes not in update_condition:
+            raise Exception(
+                f"updateNotetypes must be one of {sorted(update_condition.keys())}; "
+                f"got {updateNotetypes!r}"
+            )
+
+        self.startEditing()
+        opts = ImportAnkiPackageOptions(
+            merge_notetypes=mergeNotetypes,
+            update_notes=update_condition[updateNotes],
+            update_notetypes=update_condition[updateNotetypes],
+            with_scheduling=withScheduling,
+            with_deck_configs=withDeckConfigs,
+        )
+        req = ImportAnkiPackageRequest(package_path=path, options=opts)
+        result = collection.import_anki_package(req)
+
+        log = result.log if hasattr(result, 'log') else result
+        return {
+            'found_notes': getattr(log, 'found_notes', None),
+            'new': len(getattr(log, 'new', [])),
+            'updated': len(getattr(log, 'updated', [])),
+            'duplicate': len(getattr(log, 'duplicate', [])),
+            'conflicting': len(getattr(log, 'conflicting', [])),
+            'deck_count_after': len(collection.decks.all_names_and_ids()),
+        }
+
+
