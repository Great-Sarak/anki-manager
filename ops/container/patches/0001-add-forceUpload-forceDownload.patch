+# The success path for forceUpload / forceDownload requires a reachable
+# AnkiWeb (or compatible sync server) and is not exercised in CI for the
+# same reason `sync` is not. The error path — auth not configured — is
+# covered here; the success path is covered by integration tests that run
+# against a throwaway AnkiWeb account.
+class TestForceSync:
+    def test_forceUpload_requires_auth(self, setup, monkeypatch):
+        monkeypatch.setattr(aqt.mw.pm, "sync_auth", lambda: None)
+        with pytest.raises(Exception, match="forceUpload: auth not configured"):
+            ac.forceUpload()
+
+    def test_forceDownload_requires_auth(self, setup, monkeypatch):
+        monkeypatch.setattr(aqt.mw.pm, "sync_auth", lambda: None)
+        with pytest.raises(Exception, match="forceDownload: auth not configured"):
+            ac.forceDownload()
+
