+    def _fullSync(self, upload):
+        mw = self.window()
+        auth = mw.pm.sync_auth()
+        if not auth:
+            action = "forceUpload" if upload else "forceDownload"
+            raise Exception(f"{action}: auth not configured")
+        aqt.gui_hooks.collection_will_temporarily_close(mw.col)
+        if not upload:
